# ---- Zendesk (export) ----
# API token: Admin Center > Apps and integrations > APIs > Zendesk API > Token access
ZENDESK_SUBDOMAIN=yoursubdomain
ZENDESK_EMAIL=you@example.com
ZENDESK_API_TOKEN=your_zendesk_api_token

# ---- Chatwoot (import) ----
# CHATWOOT_INBOX_ID MUST be an API-type inbox, so importing agent replies does
# NOT send real emails to customers. Create it in Chatwoot first (see README).
CHATWOOT_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=your_chatwoot_admin_access_token
CHATWOOT_INBOX_ID=1

# ---- Optional ----
STORAGE_DIR=./storage
REQUESTS_PER_MINUTE=600
EXPORT_START_TIME=0
